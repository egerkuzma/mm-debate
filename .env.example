# Адрес Mattermost. Если бот живёт на том же хосте — localhost быстрее и надёжнее
MM_URL=http://localhost:8065

# Токены бот-аккаунтов из Integrations → Bot Accounts
MM_TOKEN_A=токен_для_первого_каталога_по_алфавиту (novator)
MM_TOKEN_B=токен_для_второго_каталога_по_алфавиту (skeptic)

# Кто может запускать дискуссии — id пользователей Mattermost через запятую
ALLOWED_USERS=

# Где лежат каталоги персонажей
PERSONAS_DIR=./personas
